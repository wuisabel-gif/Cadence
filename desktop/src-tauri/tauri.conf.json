{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cadence",
  "version": "../../package.json",
  "identifier": "io.github.wuisabel-gif.cadence",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node ../scripts/build-desktop.mjs",
    "beforeBuildCommand": "node ../scripts/build-desktop.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Cadence", "width": 1040, "height": 780, "minWidth": 380, "minHeight": 500 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
